# Local-only application configuration. Keep project data and caches on D:.
DF_WORKSPACE_DIR=D:\DatasetFactory\workspace
DF_CACHE_DIR=D:\DatasetFactory\cache
DF_FFMPEG_PATH=D:\tools\ffmpeg\bin\ffmpeg.exe
DF_FFPROBE_PATH=D:\tools\ffmpeg\bin\ffprobe.exe
DF_TESSERACT_PATH=D:\tools\tesseract-5.5.3\tesseract.exe
DF_TESSERACT_MODEL_PATH=D:\tools\tesseract-5.5.3\tessdata\eng.traineddata
DF_TESSERACT_VERSION=v5.5.3.20260724
DF_TESSERACT_RUNTIME_SHA256=C66F0F12ED76F6AA455DAC97684BBC86756D6A732380BEE09122454CFDA3F420
DF_TESSERACT_MODEL_SHA256=7D4322BD2A7749724879683FC3912CB542F19906C83BCC1A52132556427170B2
# Which OCR engine runs: tesseract (default) or rapidocr. RapidOCR reads HUD text that Tesseract
# misses, needs no text layout, and needs its two ONNX models in DF_RAPIDOCR_MODEL_DIR.
DF_OCR_ENGINE=tesseract
DF_RAPIDOCR_MODEL_DIR=D:\tools\rapidocr-3.10.0\models
apidocr-3.10.0\models
DF_RAPIDOCR_VERSION=3.10.0+onnxruntime-1.32.0
DF_RAPIDOCR_RUNTIME_SHA256=D4D9DF764064DEE9216DFA9A3933BEAEFC480B9C421A62D3F681168CEC90C23C
DF_RAPIDOCR_MODELS_SHA256=4345A537B9E649F479C94AEDF3682D106471506063C6348F4BE1B17FE5CBFC0F
DF_HOST=127.0.0.1
DF_PORT=8000
DF_LOG_LEVEL=INFO
DF_DEV_CORS_ORIGIN=http://localhost:5173
DF_FFPROBE_TIMEOUT_SECONDS=30
DF_FRAME_EXTRACTION_TIMEOUT_SECONDS=60
DF_TESSERACT_TIMEOUT_SECONDS=30
